{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Rule Definition",
  "description": "Schema for validating watchlist signal rule entries",
  "type": "object",
  "required": ["symbols"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version identifier"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the watchlist"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "market",
          "data_source",
          "signal_col",
          "entry_rule",
          "exit_rule",
          "freshness_minutes",
          "notify_channels"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9]+\\.(SZ|SH|HK)$",
            "description": "Ticker symbol with exchange suffix (e.g. 000001.SZ, 0700.HK)"
          },
          "market": {
            "type": "string",
            "enum": ["A", "ETF", "HK", "US"],
            "description": "Market classification"
          },
          "data_source": {
            "type": "string",
            "enum": ["akshare", "yfinance", "tushare", "ccxt"],
            "description": "Data provider for market data"
          },
          "signal_col": {
            "type": "string",
            "minLength": 1,
            "description": "Column name used as the primary signal price (e.g. close, Close)"
          },
          "entry_rule": {
            "type": "string",
            "minLength": 1,
            "description": "Boolean expression for entry signal evaluation"
          },
          "exit_rule": {
            "type": "string",
            "minLength": 1,
            "description": "Boolean expression for exit signal evaluation"
          },
          "freshness_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "Maximum acceptable data age in minutes before alert"
          },
          "notify_channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["dingtalk", "email", "webhook"]
            },
            "description": "Notification channels to alert on signal trigger"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
