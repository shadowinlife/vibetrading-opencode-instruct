# =============================================================================
# Dockerfile.amd64 — opencode-serve for x86_64 (Alibaba Cloud ECS)
# 基于: opencode-serve:0.0.6 (AMD64) + ClickHouse 迁移
# =============================================================================
FROM registry.cn-hangzhou.aliyuncs.com/jiefengnewsv2/opencode-serve:0.0.6

USER root

# ---------------------------------------------------------------------------
# 0. 阿里云 PyPI 内网源
# ---------------------------------------------------------------------------
RUN mkdir -p /root/.config/pip && \
    printf '[global]\nindex-url=https://mirrors.aliyun.com/pypi/simple/\n\n[install]\ntrusted-host=mirrors.aliyun.com\n' \
    > /root/.config/pip/pip.conf

# ---------------------------------------------------------------------------
# 1. 安装 Node.js 20.x + Python 3.12
# ---------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg python3 python3-venv python3-pip && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 2. 创建 /opt/venv (使用 apt 安装的 Python 3.12, 避免基础镜像 uv Python 的权限问题)
# ---------------------------------------------------------------------------
RUN /usr/bin/python3 -m venv --system-site-packages /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

# 确保 venv python 指向 apt 安装的 Python (而非基础镜像的 uv Python at /root/)
RUN ln -sf /usr/bin/python3.12 /opt/venv/bin/python3.11 && \
    ln -sf /usr/bin/python3.12 /opt/venv/bin/python3.12 && \
    ln -sf /usr/bin/python3 /opt/venv/bin/python && \
    ln -sf /usr/bin/python3 /opt/venv/bin/python3

# ---------------------------------------------------------------------------
# 2. 升级 OpenCode CLI 1.17.13 → 1.18.5
# ---------------------------------------------------------------------------
RUN npm install -g opencode-ai@1.18.5

# ---------------------------------------------------------------------------
# 3. 配置文件 (先 COPY, 再用 npm 安装 OMO 插件依赖, 避免 Bun/QEMU 崩溃)
# ---------------------------------------------------------------------------
COPY config/opencode.json.tmpl /workspace/.opencode/opencode.json.tmpl
COPY config/oh-my-openagent.json /workspace/.opencode/oh-my-openagent.json
COPY config/tui.json /workspace/.opencode/tui.json
COPY config/package.json /workspace/.opencode/package.json
COPY config/vibe-trading-tools.json /workspace/.opencode/vibe-trading-tools.json

# 用 npm 安装 OMO 插件依赖 (绕过 opencode plugin 的 Bun 崩溃)
RUN cd /workspace/.opencode && npm install --production

# ---------------------------------------------------------------------------
# 4. Python 包 (ClickHouse 迁移版 + 远端独有包)
# ---------------------------------------------------------------------------
RUN /opt/venv/bin/pip install --no-cache-dir \
    vibe-trading-ai \
    clickhouse-connect \
    playwright \
    plotly \
    kaleido \
    ta \
    pyharmonics \
    loguru \
    markdownify \
    pycryptodome \
    binance-connector \
    alpaca-trade-api \
    bottleneck \
    lz4 \
    logistro \
    pytest \
    typer \
    tzdata \
    asyncio-nats-client \
    jinja2

# ---------------------------------------------------------------------------
# 5. nano-search-mcp (editable install)
# ---------------------------------------------------------------------------
COPY nano-search-mcp/ /opt/nano-search-mcp/
RUN /opt/venv/bin/pip install --no-cache-dir -e /opt/nano-search-mcp

# ---------------------------------------------------------------------------
# 6. Playwright Chromium
# ---------------------------------------------------------------------------
RUN /opt/venv/bin/playwright install chromium --with-deps 2>/dev/null || true

# ---------------------------------------------------------------------------
# 7. 其他配置文件 + 工作区
# ---------------------------------------------------------------------------
COPY AGENTS.md /workspace/AGENTS.md
COPY skills/ /workspace/.opencode/skills/

# ---------------------------------------------------------------------------
# 8. 工作区文件
# ---------------------------------------------------------------------------
COPY workspace/scripts/ /workspace/scripts/
COPY workspace/cron_jobs/ /workspace/cron_jobs/

# ---------------------------------------------------------------------------
# 9. 入口脚本
# ---------------------------------------------------------------------------
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

# ---------------------------------------------------------------------------
# 10. 运行时目录 + opencode 用户
# ---------------------------------------------------------------------------
RUN useradd --create-home --shell /bin/bash --uid 1001 opencode && \
    mkdir -p /workspace/analysis /workspace/reports /workspace/runs \
             /workspace/tmp /workspace/cron_jobs/logs /workspace/cron_jobs/state && \
    chown -R opencode:opencode /workspace /opt/venv /home/opencode

# ---------------------------------------------------------------------------
# 11. 环境变量
# ---------------------------------------------------------------------------
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    VIRTUAL_ENV=/opt/venv \
    LANGCHAIN_PROVIDER=dashscope \
    LANGCHAIN_MODEL_NAME=qwen3.7-max \
    DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 \
    LANGCHAIN_TEMPERATURE=0.3 \
    TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 12. 端口 + 健康检查
# ---------------------------------------------------------------------------
EXPOSE 4096

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf -o /dev/null http://localhost:4096/health || exit 1

# ---------------------------------------------------------------------------
# 13. 运行时
# ---------------------------------------------------------------------------
USER opencode
ENTRYPOINT ["/workspace/entrypoint.sh"]